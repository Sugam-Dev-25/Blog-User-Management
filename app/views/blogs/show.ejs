<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= blog.title %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>

        *{
            font-family: "Segoe UI", sans-serif;
        }

        body{
            background:#f4f6f9;
        }

        .blog-card{
            border:none;
            border-radius:18px;
            overflow:hidden;
        }

        .blog-header{
            background:linear-gradient(135deg,#0d6efd,#3b82f6);
            color:#fff;
            padding:30px;
        }

        .blog-image{
            width:100%;
            max-height:450px;
            object-fit:cover;
            border-radius:12px;
        }

        .author-box{
            background:#f8f9fa;
            border-radius:10px;
            padding:15px;
            margin-top:20px;
            margin-bottom:25px;
        }

        .blog-content{
            line-height:1.9;
            font-size:17px;
            color:#444;
            text-align:justify;
        }

        .btn{
            border-radius:10px;
        }

    </style>

</head>

<body>

<div class="container py-5">

    <div class="card shadow blog-card">

        <div class="blog-header">

            <h2 class="mb-2">

                <%= blog.title %>

            </h2>

            <small>

                Blog Details

            </small>

        </div>

        <div class="card-body p-4">

            <% if(blog.image){ %>

                <img
                    src="/uploads/blogs/<%= blog.image %>"
                    class="blog-image mb-4"
                >

            <% } %>

            <div class="author-box">

                <div class="row">

                    <div class="col-md-6">

                        <strong>👤 Author :</strong>

                        <%= blog.author.name %>

                    </div>

                    <div class="col-md-6 text-md-end">

                        <strong>📅 Published :</strong>

                        <%= new Date(blog.createdAt).toLocaleDateString() %>

                    </div>

                </div>

            </div>

            <div class="blog-content">

                <%= blog.description %>

            </div>

            <hr>

            <div class="d-flex justify-content-between">

                <a
                    href="/blogs"
                    class="btn btn-secondary"
                >

                    ← Back

                </a>

                <% if(user && (user.id == blog.author._id.toString() || user.role === "admin")) { %>

                    <a
                        href="/blogs/edit/<%= blog._id %>"
                        class="btn btn-warning"
                    >

                        ✏️ Edit Blog

                    </a>

                <% } %>

            </div>

        </div>

    </div>

</div>

</body>

</html>