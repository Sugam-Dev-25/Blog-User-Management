<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background:#f4f6f9;
        }

        .dashboard-card{
            border:none;
            border-radius:15px;
            overflow:hidden;
        }

        .dashboard-header{
            background:linear-gradient(135deg,#0d6efd,#3b82f6);
            color:white;
            padding:30px;
        }

        .profile-box{
            background:#fff;
            border-radius:12px;
            padding:20px;
            box-shadow:0 5px 15px rgba(0,0,0,.08);
        }

        .info{
            font-size:17px;
            margin-bottom:12px;
        }

        .btn{
            border-radius:10px;
        }

        .btn-group-custom a{
            margin:5px;
        }

        .logout-btn{
            width:180px;
        }
    </style>

</head>

<body>

<div class="container py-5">

    <div class="card dashboard-card shadow">

        <div class="dashboard-header">

            <h2 class="fw-bold">
                Dashboard
            </h2>

            <p class="mb-0">
                Welcome back, <strong><%= user.name %></strong>
            </p>

        </div>

        <div class="card-body">

            <div class="profile-box">

                <div class="row">

                    <div class="col-md-8">

                        <p class="info">
                            <strong>Name :</strong>
                            <%= user.name %>
                        </p>

                        <p class="info">
                            <strong>Email :</strong>
                            <%= user.email %>
                        </p>

                        <p class="info">
                            <strong>Role :</strong>

                            <% if(user.role==="admin"){ %>

                                <span class="badge bg-danger">
                                    Admin
                                </span>

                            <% }else{ %>

                                <span class="badge bg-success">
                                    User
                                </span>

                            <% } %>

                        </p>

                    </div>

                </div>

            </div>

            <div class="mt-4 btn-group-custom">

                <a href="/blogs" class="btn btn-primary">
                    📚 All Blogs
                </a>

                <a href="/blogs/create" class="btn btn-success">
                    ➕ Create Blog
                </a>

                <% if(user.role==="admin"){ %>

                    <a href="/users" class="btn btn-warning text-white">
                        👥 Manage Users
                    </a>

                <% } %>

                <a href="/profile" class="btn btn-info text-white">
                    👤 My Profile
                </a>

            </div>

            <hr class="my-4">

            <a
                href="/api/auth/logout"
                class="btn btn-danger logout-btn"
            >
                🚪 Logout
            </a>

        </div>

    </div>

</div>

</body>
</html>