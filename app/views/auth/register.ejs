<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            font-family: "Segoe UI", sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0d6efd, #3b82f6);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 0;
        }

        .register-card {
            width: 480px;
            border: none;
            border-radius: 18px;
            overflow: hidden;
        }

        .card-header {
            background: #0d6efd;
            color: white;
            text-align: center;
            padding: 25px;
        }

        .card-header h2 {
            margin: 0;
            font-weight: bold;
        }

        .logo {
            font-size: 55px;
            margin-bottom: 15px;
        }

        .card-body {
            padding: 35px;
        }

        .form-control {
            height: 50px;
            border-radius: 10px;
        }

        input[type="file"] {
            height: auto;
            padding: 10px;
        }

        .btn {
            height: 48px;
            border-radius: 10px;
        }

        .bottom-link {
            text-align: center;
            margin-top: 20px;
        }

        .bottom-link a {
            text-decoration: none;
            font-weight: 600;
        }

        .profile-preview {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #dee2e6;
            display: none;
            margin: 0 auto 20px;
        }

        .alert {
            border-radius: 10px;
        }
    </style>
</head>

<body>

<div class="card shadow-lg register-card">

    <div class="card-header">

        <div class="logo">
            👤
        </div>

        <h2>Create Account</h2>

        <small>Blog Management System</small>

    </div>

    <div class="card-body">

        <% if(success && success.length > 0){ %>

            <div class="alert alert-success">
                <%= success[0] %>
            </div>

        <% } %>

        <% if(error && error.length > 0){ %>

            <div class="alert alert-danger">
                <%= error[0] %>
            </div>

        <% } %>

        <img id="preview" class="profile-preview">

        <form action="/api/auth/register" method="POST" enctype="multipart/form-data">

            <div class="mb-3">

                <label class="form-label">
                    Full Name
                </label>

                <input
                    type="text"
                    name="name"
                    class="form-control"
                    placeholder="Enter your full name"
                    required
                >

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Email Address
                </label>

                <input
                    type="email"
                    name="email"
                    class="form-control"
                    placeholder="Enter your email"
                    required
                >

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Password
                </label>

                <input
                    type="password"
                    name="password"
                    class="form-control"
                    placeholder="Enter your password"
                    required
                >

            </div>

            <div class="mb-4">

                <label class="form-label">
                    Profile Image (Optional)
                </label>

                <input
                    type="file"
                    name="profile"
                    id="profile"
                    class="form-control"
                    accept=".jpg,.jpeg,.png,.webp"
                >

            </div>

            <button class="btn btn-primary w-100">

                Register

            </button>

        </form>

        <div class="bottom-link">

            Already have an account?

            <a href="/login">

                Login

            </a>

        </div>

    </div>

</div>

<script>

const profile = document.getElementById("profile");
const preview = document.getElementById("preview");

profile.addEventListener("change", function(){

    const file = this.files[0];

    if(file){

        preview.src = URL.createObjectURL(file);

        preview.style.display = "block";

    }

});

</script>

</body>

</html>